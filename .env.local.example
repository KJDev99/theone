# Copy this file to .env.local and fill in the two values from
# Supabase Dashboard -> Settings -> API.
#
# Next.js only reads .env.local — putting the keys in THIS file does nothing.
#
# Leave .env.local out entirely and the app still runs: it then keeps
# everything in the browser, exactly as it did before Supabase.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Optional. Set it to a teacher's user id when several teachers share one
# project and the public board should show only that teacher's classes.
# NEXT_PUBLIC_TEACHER_ID=
